# Leave empty: the app calls /api on its own origin, which Vercel (vercel.json)
# and the Vite dev server forward to the API. Only set this to bypass the proxy.
VITE_API_URL=

# Local development only: where the Vite dev server forwards /api requests.
# Defaults to the deployed API; use e.g. http://localhost:5000 for a local API.
VITE_DEV_API_TARGET=
